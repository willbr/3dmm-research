file(MAKE_DIRECTORY "${TEST_DIR}")
set(inputs "${MAIN_CHK}" "${CONTENT_DIR}/tmpls.3cn" "${CONTENT_DIR}/bkgds.3cn" "${CONTENT_DIR}/tdfs.3cn" "${CONTENT_DIR}/mtrls.3cn")
foreach(input IN LISTS inputs)
  file(SHA256 "${input}" before)
  string(SHA256 key "${input}")
  set(before_${key} "${before}")
endforeach()
execute_process(COMMAND "${API_EXE}" "${MAIN_CHK}" "${CONTENT_DIR}/tmpls.3cn" "${TEST_DIR}/actor.ppm" RESULT_VARIABLE result TIMEOUT 90)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Actor/prop previews failed: ${result}")
endif()
execute_process(COMMAND "${FIXTURE_EXE}" "${TEST_DIR}/scene.3mm" "${CONTENT_DIR}/bkgds.3cn" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot create scene fixture: ${result}")
endif()
file(SHA256 "${TEST_DIR}/scene.3mm" scene_before)
execute_process(COMMAND "${SCENE_EXE}" "${MAIN_CHK}" "${TEST_DIR}/scene.3mm" "${CONTENT_DIR}/tmpls.3cn" "${CONTENT_DIR}/bkgds.3cn" "${CONTENT_DIR}/tdfs.3cn" RESULT_VARIABLE result TIMEOUT 90)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Scene previews failed: ${result}")
endif()
execute_process(COMMAND "${BACKGROUND_EXE}" "${MAIN_CHK}" "${CONTENT_DIR}/bkgds.3cn" RESULT_VARIABLE result TIMEOUT 90)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Background previews failed: ${result}")
endif()
if(GUI_EXE)
  foreach(kind IN ITEMS actor prop scene background)
    if(kind STREQUAL "actor")
      set(archive "${CONTENT_DIR}/tmpls.3cn")
      set(selection TMPL:2010)
    elseif(kind STREQUAL "prop")
      set(archive "${CONTENT_DIR}/tmpls.3cn")
      set(selection TMPL:1010)
    elseif(kind STREQUAL "scene")
      set(archive "${TEST_DIR}/scene.3mm")
      set(selection SCEN:0)
    else()
      set(archive "${CONTENT_DIR}/bkgds.3cn")
      set(selection BKGD:0)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_RENDER_DRIVER=software
      "${GUI_EXE}" --smoke-test --resources "${MAIN_CHK}" --content-dir "${CONTENT_DIR}"
      --select "${selection}" --screenshot "${TEST_DIR}/${kind}.bmp" "${archive}"
      RESULT_VARIABLE result TIMEOUT 45)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${kind} preview SDL/ImGui smoke failed: ${result}")
    endif()
  endforeach()
endif()
file(SHA256 "${TEST_DIR}/scene.3mm" scene_after)
if(NOT scene_before STREQUAL scene_after)
  message(FATAL_ERROR "Preview modified its scene document")
endif()
foreach(input IN LISTS inputs)
  file(SHA256 "${input}" after)
  string(SHA256 key "${input}")
  if(NOT after STREQUAL before_${key})
    message(FATAL_ERROR "Preview modified ${input}")
  endif()
endforeach()
