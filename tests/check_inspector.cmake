file(MAKE_DIRECTORY "${TEST_DIR}")
set(fixture "${TEST_DIR}/inspector.3mm")
execute_process(COMMAND "${FIXTURE_EXE}" "${fixture}" 5 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot generate inspector fixture")
endif()
set(gst_fixture "${TEST_DIR}/strings.3mm")
execute_process(COMMAND "${GST_FIXTURE_EXE}" "${gst_fixture}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot generate string table fixtures")
endif()
file(READ "${gst_fixture}" gst_before HEX)
file(READ "${fixture}" before HEX)
file(WRITE "${TEST_DIR}/invalid.3mm" "not a chunky file")
execute_process(COMMAND "${TEST_EXE}" "${fixture}" "${TEST_DIR}/invalid.3mm" "${gst_fixture}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Inspector data checks failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_RENDER_DRIVER=software
  "${GUI_EXE}" --smoke-test --screenshot "${TEST_DIR}/smoke.bmp" "${fixture}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Inspector SDL/ImGui smoke check failed: ${result}")
endif()
file(SIZE "${TEST_DIR}/smoke.bmp" screenshot_size)
if(screenshot_size LESS 4096)
  message(FATAL_ERROR "Inspector did not render a screenshot")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_RENDER_DRIVER=software
  "${GUI_EXE}" --smoke-test --screenshot "${TEST_DIR}/strings.bmp" "${gst_fixture}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "String table SDL/ImGui smoke check failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_RENDER_DRIVER=software
  "${GUI_EXE}" --smoke-test "${TEST_DIR}/invalid.3mm" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "Inspector smoke mode must reject invalid archives")
endif()
file(READ "${fixture}" after HEX)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Inspector modified its input archive")
endif()
file(READ "${gst_fixture}" gst_after HEX)
if(NOT gst_before STREQUAL gst_after)
  message(FATAL_ERROR "Inspector modified its string table fixtures")
endif()
