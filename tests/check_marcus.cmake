file(MAKE_DIRECTORY "${TEST_DIR}")
set(inputs "${RESOURCES}" "${CONTENT}/tmpls.3cn" "${CONTENT}/bkgds.3cn"
  "${CONTENT}/tdfs.3cn" "${CONTENT}/mtrls.3cn")
foreach(input IN LISTS inputs)
  string(SHA256 key "${input}")
  file(SHA256 "${input}" before_${key})
endforeach()
set(movie "${TEST_DIR}/marcus.3mm")
execute_process(COMMAND "${FIXTURE_EXE}" "${movie}" "${CONTENT}/bkgds.3cn" "${RESOURCES}"
  "${CONTENT}/tmpls.3cn" RESULT_VARIABLE result TIMEOUT 45)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not create the Marcus movie fixture: ${result}")
endif()
file(SHA256 "${movie}" movie_before)
set(scene_only "${TEST_DIR}/scene.3mm")
execute_process(COMMAND "${FIXTURE_EXE}" "${scene_only}" "${CONTENT}/bkgds.3cn" "${RESOURCES}"
  RESULT_VARIABLE result TIMEOUT 45)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not create the standalone scene fixture: ${result}")
endif()
execute_process(COMMAND "${API_EXE}" "${movie}" "${RESOURCES}" "${CONTENT}" "${scene_only}"
  RESULT_VARIABLE result TIMEOUT 90)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Marcus C API integration failed: ${result}")
endif()
file(SHA256 "${movie}" movie_after)
if(NOT movie_before STREQUAL movie_after)
  message(FATAL_ERROR "Marcus changed the movie")
endif()
foreach(input IN LISTS inputs)
  string(SHA256 key "${input}")
  file(SHA256 "${input}" after)
  if(NOT after STREQUAL before_${key})
    message(FATAL_ERROR "Marcus changed ${input}")
  endif()
endforeach()
