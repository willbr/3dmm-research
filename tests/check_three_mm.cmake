file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(variant RANGE 0 6)
  set(input "${TEST_DIR}/fixture-${variant}.3mm")
  execute_process(COMMAND "${FIXTURE_EXE}" "${input}" "${variant}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture ${variant} failed: ${result}")
  endif()
  file(SHA256 "${input}" before)
  execute_process(COMMAND "${DUMP_EXE}" dump --json "${input}"
    RESULT_VARIABLE result OUTPUT_VARIABLE dump ERROR_VARIABLE errors)
  file(SHA256 "${input}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Dump modified input ${variant}")
  endif()
  if(variant EQUAL 4 OR variant EQUAL 6)
    if(result EQUAL 0 OR NOT dump STREQUAL "")
      message(FATAL_ERROR "Malformed record or missing caption reference must fail with no JSON output")
    endif()
    continue()
  endif()
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Dump ${variant} failed: ${errors}")
  endif()
  string(JSON schema GET "${dump}" schema)
  string(JSON count LENGTH "${dump}" chunks)
  if(NOT schema STREQUAL "3mm-dump-1" OR NOT count EQUAL 6)
    message(FATAL_ERROR "Unexpected dump schema or chunk count")
  endif()
  set(dump_${variant} "${dump}")
endforeach()
if(NOT dump_0 STREQUAL dump_1)
  message(FATAL_ERROR "Physical layout changed normalized output")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/fixtures/three-mm-dump-v1.json" golden)
# Permit a Windows checkout to translate the checked-in fixture's line endings.
string(REPLACE "\r\n" "\n" golden "${golden}")
if(NOT dump_0 STREQUAL golden)
  message(FATAL_ERROR "Dump differs from the reviewed v1 graph/payload baseline")
endif()
file(SHA256 "${TEST_DIR}/fixture-0.3mm" hash0)
file(SHA256 "${TEST_DIR}/fixture-1.3mm" hash1)
if(hash0 STREQUAL hash1)
  message(FATAL_ERROR "Layout fixtures must have different physical bytes")
endif()
if(dump_0 STREQUAL dump_2 OR dump_0 STREQUAL dump_3)
  message(FATAL_ERROR "Normalization hid a frame or ID change")
endif()
# The expected decoded values are independent of the writer's struct layout.
string(JSON actor GET "${dump_0}" chunks 0 fields actor_id)
string(JSON last GET "${dump_0}" chunks 3 fields last_frame)
string(JSON data GET "${dump_0}" chunks 5 payload_hex)
string(JSON child GET "${dump_0}" chunks 3 children 0 number)
string(JSON name GET "${dump_0}" chunks 3 name_units_hex)
if(NOT actor EQUAL 23 OR NOT last EQUAL 12 OR NOT data STREQUAL "00225cff"
    OR NOT child STREQUAL "0000002a" OR NOT name STREQUAL "5363656e6520226f6e65225c0a")
  message(FATAL_ERROR "Incorrect decoded fixture values or child ordering")
endif()
string(JSON first GET "${dump_0}" chunks 4 fields first_frame)
string(JSON right GET "${dump_0}" chunks 4 fields bounds 2)
string(JSON text_type GET "${dump_0}" chunks 4 fields text type)
string(JSON packed GET "${dump_5}" chunks 5 packed)
string(JSON unpacked GET "${dump_5}" chunks 5 payload_hex)
string(REPEAT "61" 1024 expected_payload)
if(NOT first EQUAL 2 OR NOT right EQUAL 101 OR NOT text_type STREQUAL "52545854"
    OR NOT packed OR NOT unpacked STREQUAL expected_payload)
  message(FATAL_ERROR "Incorrect caption decoding or compressed payload")
endif()
execute_process(COMMAND "${DUMP_EXE}" dump --json "${TEST_DIR}/fixture-0.3mm"
  RESULT_VARIABLE result OUTPUT_VARIABLE repeated)
if(NOT result EQUAL 0 OR NOT repeated STREQUAL dump_0)
  message(FATAL_ERROR "Repeated dumps differ")
endif()
file(WRITE "${TEST_DIR}/truncated.3mm" "not a chunky file")
foreach(input IN ITEMS "${TEST_DIR}/missing.3mm" "${TEST_DIR}/truncated.3mm")
  execute_process(COMMAND "${DUMP_EXE}" dump --json "${input}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(result EQUAL 0 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Invalid input was accepted")
  endif()
endforeach()
execute_process(COMMAND "${DUMP_EXE}" dump RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 2 OR NOT output STREQUAL "")
  message(FATAL_ERROR "Invalid arguments must report usage and exit 2")
endif()
