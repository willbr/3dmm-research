file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(variant IN ITEMS 0 4 5)
  execute_process(COMMAND "${FIXTURE_EXE}" "${TEST_DIR}/fixture-${variant}.3mm" "${variant}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot generate archive API fixture ${variant}")
  endif()
endforeach()
execute_process(COMMAND "${GST_FIXTURE_EXE}" "${TEST_DIR}/strings.3mm" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot generate archive API GST fixture")
endif()
foreach(name IN ITEMS fixture-0 fixture-4 fixture-5 strings)
  file(SHA256 "${TEST_DIR}/${name}.3mm" before_${name})
endforeach()
execute_process(COMMAND "${TEST_EXE}" "${TEST_DIR}/fixture-0.3mm" "${TEST_DIR}/fixture-4.3mm"
  "${TEST_DIR}/fixture-5.3mm" "${TEST_DIR}/strings.3mm" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Archive API regression checks failed: ${result}")
endif()
foreach(name IN ITEMS fixture-0 fixture-4 fixture-5 strings)
  file(SHA256 "${TEST_DIR}/${name}.3mm" after)
  if(NOT after STREQUAL before_${name})
    message(FATAL_ERROR "Archive API modified ${name}.3mm")
  endif()
endforeach()
