include_guard(GLOBAL)
if(KAUAI_MIDI_SYNTH)
  if(WIN32)
    enable_language(RC)
  else()
    enable_language(ASM)
  endif()
endif()
function(studio_bundle_midi target)
  if(NOT KAUAI_MIDI_SYNTH)
    return()
  endif()
  set(bundle_dir "${PROJECT_BINARY_DIR}/generated/studio-midi")
  file(MAKE_DIRECTORY "${bundle_dir}")
  file(READ "${PROJECT_SOURCE_DIR}/docs/licenses/generaluser-gs-LICENSE.txt" bank_license)
  file(READ "${PROJECT_SOURCE_DIR}/docs/licenses/tinysoundfont-LICENSE.txt" code_license)
  file(READ "${PROJECT_SOURCE_DIR}/docs/licenses/tinysoundfont-PATCHES.md" patches)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/docs/licenses/generaluser-gs-LICENSE.txt"
    "${PROJECT_SOURCE_DIR}/docs/licenses/tinysoundfont-LICENSE.txt"
    "${PROJECT_SOURCE_DIR}/docs/licenses/tinysoundfont-PATCHES.md")
  configure_file("${PROJECT_SOURCE_DIR}/cmake/studio_midi_licenses.h.in"
    "${bundle_dir}/studio_midi_licenses.h" @ONLY)
  target_include_directories(${target} PRIVATE "${bundle_dir}")
  target_compile_definitions(${target} PRIVATE STUDIO_BUNDLED_MIDI)
  if(WIN32)
    file(TO_CMAKE_PATH "${KAUAI_MIDI_BANK_FILE}" bank_path)
    file(GENERATE OUTPUT "${bundle_dir}/soundfont.rc" CONTENT "30001 RCDATA \"${bank_path}\"\n")
    set(bank_source "${bundle_dir}/soundfont.rc")
  else()
    configure_file("${PROJECT_SOURCE_DIR}/cmake/studio_soundfont.S.in"
      "${bundle_dir}/soundfont.S" @ONLY)
    set(bank_source "${bundle_dir}/soundfont.S")
  endif()
  set_source_files_properties("${bank_source}" PROPERTIES OBJECT_DEPENDS "${KAUAI_MIDI_BANK_FILE}")
  target_sources(${target} PRIVATE "${bank_source}")
endfunction()
